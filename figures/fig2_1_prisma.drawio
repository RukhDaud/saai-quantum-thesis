<mxfile host="app.diagrams.net"><diagram name="PRISMA 2020 flow"><mxGraphModel dx="900" dy="640" grid="1" gridSize="10" guides="1" page="1" pageWidth="900" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="idl" value="&lt;b&gt;Identification&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F2;strokeColor=#333333;fontFamily=Times New Roman;fontSize=13;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="40" height="170" as="geometry"/></mxCell><mxCell id="scl" value="&lt;b&gt;Screening&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F2;strokeColor=#333333;fontFamily=Times New Roman;fontSize=13;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="40" height="290" as="geometry"/></mxCell><mxCell id="inl" value="&lt;b&gt;Included&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCE6F2;strokeColor=#333333;fontFamily=Times New Roman;fontSize=13;horizontal=0;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="40" height="90" as="geometry"/></mxCell><mxCell id="id" value="&lt;b&gt;Records identified (n = 183)&lt;/b&gt;&lt;br&gt;Reference lists of the research proposal&lt;br&gt;and earlier drafts (n = 134)&lt;br&gt;Structured keyword search and backward/forward&lt;br&gt;citation tracing (n = 38)&lt;br&gt;Standards, regulations, tools and statistical&lt;br&gt;methods added during method development (n = 11)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontFamily=Times New Roman;fontSize=13;align=left;spacingLeft=6;arcSize=6;" vertex="1" parent="1"><mxGeometry x="80" y="20" width="420" height="170" as="geometry"/></mxCell><mxCell id="dup" value="&lt;b&gt;Records removed before screening&lt;/b&gt;&lt;br&gt;Duplicate records (n = 8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontFamily=Times New Roman;fontSize=13;align=left;spacingLeft=6;arcSize=6;" vertex="1" parent="1"><mxG